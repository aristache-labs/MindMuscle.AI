{
  "name": "mindmuscle-ai",
  "version": "1.0.2",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "prebuild": "expo prebuild",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "clean": "npx expo start --clear",
    "sentry:upload": "node scripts/sentry-debug-upload.mjs",
    "sentry:upload:ios": "node scripts/sentry-debug-upload.mjs --platform ios",
    "sentry:upload:android": "node scripts/sentry-debug-upload.mjs --platform android",
    "sentry:upload:web": "node scripts/sentry-debug-upload.mjs --platform web",
    "sentry:upload:staging": "node scripts/sentry-debug-upload.mjs --environment staging",
    "sentry:upload:dev": "node scripts/sentry-debug-upload.mjs --environment development --skip-cleanup",
    "sentry:validate": "npx @sentry/cli releases files $(node -p \"require('./package.json').version\") validate",
    "sentry:info": "npx @sentry/cli info",
    "sentry:test": "node scripts/test-sentry-connection.mjs",
    "sentry:test:replay": "node scripts/test-sentry-mobile-replay.js",
    "sentry:release": "bash scripts/sentry-release.sh",
    "sentry:release:win": "powershell -ExecutionPolicy Bypass -File scripts/sentry-release.ps1",
    "build:release": "npx expo prebuild && npm run sentry:upload"
  },
  "dependencies": {
    "@expo/config-plugins": "~10.0.0",
    "@expo/metro-config": "~0.20.0",
    "@expo/metro-runtime": "^5.0.4",
    "@expo/prebuild-config": "^9.0.6",
    "@motionone/animation": "^10.18.0",
    "@motionone/dom": "^10.18.0",
    "@motionone/utils": "^10.18.0",
    "@ngrok/ngrok": "^1.5.1",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/datetimepicker": "8.3.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-community/slider": "4.5.6",
    "@react-native-picker/picker": "2.11.0",
    "@sentry/cli": "^2.46.0",
    "@sentry/react-native": "~6.14.0",
    "@supabase/supabase-js": "^2.49.5-next.1",
    "@tanstack/react-query": "^5.75.1",
    "@tanstack/react-query-persist-client": "^5.75.7",
    "@types/crypto-js": "^4.2.2",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^3.3.1",
    "expo": "53.0.11",
    "expo-application": "~6.1.4",
    "expo-asset": "~11.1.5",
    "expo-av": "~15.1.6",
    "expo-build-properties": "^0.14.6",
    "expo-camera": "~16.1.8",
    "expo-constants": "~17.1.6",
    "expo-crypto": "~14.1.5",
    "expo-dev-client": "~5.2.0",
    "expo-device": "~7.1.4",
    "expo-file-system": "~18.1.9",
    "expo-font": "~13.3.1",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.3.0",
    "expo-image-picker": "^16.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.4",
    "expo-navigation-bar": "~4.2.5",
    "expo-network": "~7.1.5",
    "expo-notifications": "~0.31.3",
    "expo-router": "~5.1.0",
    "expo-secure-store": "~14.2.3",
    "expo-splash-screen": "~0.30.9",
    "expo-sqlite": "~15.2.12",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.8",
    "expo-updates": "~0.28.14",
    "expo-web-browser": "~14.1.6",
    "firebase": "^11.7.3",
    "nativewind": "^2.0.11",
    "node-libs-react-native": "^1.2.1",
    "openai": "^4.46.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.3",
    "react-native-calendars": "^1.1312.0",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-gifted-charts": "^1.4.61",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-paper": "^5.14.5",
    "react-native-ratings": "^8.1.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.20.0",
    "stream-browserify": "^3.0.0",
    "tailwindcss": "^3.3.2",
    "typescript": "^5.3.3",
    "web-streams-polyfill": "^3.2.1",
    "zod": "^3.25.50",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.0.10",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^8.57.1",
    "eslint-config-universe": "^12.1.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.2.1",
    "jest-expo": "^53.0.7",
    "prettier": "^3.0.3",
    "ts-jest": "^29.3.4"
  },
  "private": true,
  "eslintConfig": {
    "extends": "universe/native"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  },
  "overrides": {
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.3",
    "promise": "8.3.0",
    "fbjs": {
      "promise": "8.3.0"
    }
  },
  "resolutions": {
    "promise": "8.3.0",
    "fbjs/promise": "8.3.0",
    "**/promise": "8.3.0"
  }
}
