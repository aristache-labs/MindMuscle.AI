{
  "cli": {
    "version": ">= 3.17.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "buildConfiguration": "Debug"
      },
      "prebuildCommand": "npx expo prebuild",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "channel": "development"
    },
    "preview": {
      "developmentClient": false,      // ← embed JS, no Metro
      "distribution": "internal",      // ← internal/TestFlight only
      "ios": {
        "buildConfiguration": "Release"// ← use Xcode "Release" scheme
      },
      "android": {
        "buildType": "apk"             // ← produce an .apk for sideload
      },
      "prebuildCommand": "npx expo prebuild",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "channel": "preview"
    },
    "testflight": {
      "developmentClient": false,      // embed JS bundle
      "distribution": "store",         // App Store provisioning
      "ios": {
        "buildConfiguration": "Release"
      },
      "prebuildCommand": "npx expo prebuild",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "channel": "testflight"
    },
    "production": {
      "developmentClient": false,
      "distribution": "store",
      "prebuildCommand": "npx expo prebuild",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "channel": "production"
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "appleId": "apple.adriancristache@gmail.com"
      }
    },
    "production": {}
  }
}
